<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark launch theme to eliminate white flash on cold start.
         Uses the app's dark surface color (#0a0a0a) as the window background
         so no white flash appears between tapping the icon and the splash screen. -->
    <style name="Theme.KAC" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#000000</item>
        <item name="colorPrimaryDark">#000000</item>
        <item name="colorAccent">#FFFFFF</item>
        <item name="android:windowBackground">@color/splash_background</item>

        <!-- Android 12+ SplashScreen API -->
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:statusBarColor">@color/splash_background</item>
        <item name="android:navigationBarColor">@color/splash_background</item>
    </style>

    <!-- Splash screen theme with same dark background for seamless transition -->
    <style name="Theme.KAC.Splash" parent="Theme.KAC">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
